      "semantic_bindings": [
        "quantity is the number of patients discharged",
        "completed stay requires length_of_stay_remaining at or below zero",
        "released patients free occupied beds"
      ],
      "tests": [
        "Discharging one recovering patient with no stay remaining decreases patient count and occupied beds and increases available beds.",
        "Patients with remaining stay are refused.",
        "Patients not marked recovering are refused.",
        "A discharge larger than the cohort is permitted to begin and can expose inconsistent totals."
