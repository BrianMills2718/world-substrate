      "checks": [
        {
          "label": "forklift is held by actor",
          "left": {
            "participant": {
              "name": "forklift",
              "path": "ownership.owner_ref"
            }
          },
          "op": "eq",
          "right": {
            "owner_ref": "actor"
          }
        },
        {
          "label": "forklift is colocated",
          "left": {
            "participant": {
              "name": "forklift",
