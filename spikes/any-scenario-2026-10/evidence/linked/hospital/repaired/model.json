    "actor_decisions": [
      {
        "actor": "clinical_staff",
        "allowed_only_when": [
          "A ventilator assignment is allowed only when an operational ventilator is available and the selected patient requires ventilation.",
          "Ventilator reassignment is allowed only when the receiving patient requires ventilation and the hospital has an allocation policy permitting reassignment.",
          "A ventilator order is allowed only when the supplier has inventory and the hospital has not exceeded its ordering limit of four ventilators per day.",
          "Patient admission is allowed only when occupied beds are fewer than staffed beds."
        ],
        "may_attempt": [
          "Assign an available operational ventilator to a patient requiring ventilation.",
          "Remove a ventilator from one patient and assign it to another patient requiring ventilation.",
          "Choose the allocation policy used to rank patients for scarce ventilators.",
          "Order additional ventilators from the medical supplier.",
          "Admit an arriving patient to an available staffed bed."
        ]
      },
      {
        "actor": "medical_supplier",
        "allowed_only_when": [
          "An order is accepted only when supplier inventory is at least the ordered quantity.",
          "A shipment is made only after the stated seven-day delivery delay."
        ],
        "may_attempt": [
          "Accept a hospital order.",
          "Ship ordered ventilators after the delivery delay."
        ]
      }
    ],
    "assumptions": [
      "The hospital starts with 40 physical beds and 40 staffed beds.",
      "The hospital starts with 36 occupied beds and 4 available beds.",
      "The hospital owns six ventilators, all initially operational; four are in use and two are available.",
      "The flu surge produces an average of six new hospital arrivals per day; arrivals are modeled as a stochastic count around that mean.",
      "Eight hospitalized patients initially require ventilation, including four currently ventilated and four waiting.",
      "Each ventilated patient requires one ventilator.",
      "The average remaining ventilation requirement is five days per patient.",
      "A ventilated patient has a 10% daily recovery probability, a 3% daily death probability, and otherwise remains ventilated unless equipment fails or staff reassigns the ventilator.",
      "A patient requiring ventilation without a ventilator has a 15% daily death probability.",
      "Ventilator failure probability is 0.005 per ventilator-day, and failed ventilators are unavailable until repaired.",
      "No ventilator repairs occur during the initial model version unless explicitly added as a process.",
      "The hospital has 80 staff members, sufficient to staff all 40 beds initially; staffing does not decline during the simulation.",
      "The supplier initially has 20 ventilators, can deliver at most four per day, and has a seven-day delivery delay.",
      "Supplier replenishment is omitted unless explicitly added; therefore supplier inventory can only decrease.",
      "Patients are represented as aggregate state counts rather than individually simulated people, except that allocation decisions conceptually rank individual patients by clinical priority.",
      "All arrivals, clinical transitions, deaths, recoveries, failures, orders, and deliveries are resolved once per one-day tick.",
      "The initial allocation policy is a clinical priority score, with ties resolved randomly.",
      "Ventilator orders do not increase usable capacity until delivery occurs.",
      "Patients who recover or die immediately release their bed and any ventilator they occupied within the same daily update."
    ],
