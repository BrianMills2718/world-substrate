            "literal": "ventilated"
          }
        }
      ],
      "limits": [
        "The legacy action does not identify a ventilator-stock participant, so it records the patient assignment but cannot update a particular stock's in-use count.",
        "Use assign-ventilators-by-staff when the selected ventilator stock must also be updated.",
        "Ventilation status is cohort-level, so it cannot distinguish partially ventilated patients within one group.",
        "Only single-ventilator assignments are offered to limit cohort-level ambiguity."
      ],
      "mechanic_id": "assign-ventilators-v1",
      "parameters": {
        "quantity": [
          1
        ]
      },
      "participants": {
        "patient_group": {
          "categories": [
            "flu patient",
            "patient group"
          ],
          "components": [
            "patient_group"
          ]
        }
      },
      "rationale": "Clinical staff can perform the legacy assignment action, while the patient cohort records that ventilation was assigned.",
      "schema_version": "world-substrate-action-mechanic/v0",
      "semantic_bindings": [
        "the acting clinical staff perform the assignment",
        "quantity is the number of ventilators represented by the assignment",
        "ventilated records assignment to the patient cohort",
        "the staff-operated action with a ventilator participant records equipment use"
      ],
      "tests": [
        "Clinical staff can assign ventilation to a colocated nonempty patient group that needs it.",
        "Patients not marked as needing ventilation are refused.",
        "An empty patient group is refused.",
        "Patients at another location are refused.",
        "A zero or negative assignment quantity is refused."
      ],
      "version": "2.0.0"
    },
    {
      "action_kind": "provide-patient-care",
      "actor_selector": {
        "categories": [
          "clinical staff",
          "actor"
        ],
        "components": [
          "clinical_staff"
        ]
      },
      "checks": [
        {
          "label": "the patients are with the clinical staff",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "location.location_id"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          }
        },
        {
          "label": "the care task count is positive",
          "left": {
            "action_field": "task_count"
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        },
        {
          "label": "the patient group has patients",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.patient_count"
            }
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        },
        {
          "label": "the hospital stay is still in progress",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.length_of_stay_remaining"
            }
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        },
        {
          "label": "the patients have not recovered",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.illness_stage"
            }
          },
          "op": "ne",
          "right": {
            "literal": "recovered"
          }
        }
      ],
      "effects": [
        {
          "op": "subtract",
          "participant": "actor",
          "path": "components.clinical_staff.daily_staff_capacity",
          "value": {
            "action_field": "task_count"
          }
        },
        {
          "op": "subtract",
          "participant": "patient_group",
          "path": "components.patient_group.length_of_stay_remaining",
          "value": {
            "literal": 1
          }
        },
        {
          "op": "set",
          "participant": "patient_group",
          "path": "components.patient_group.illness_stage",
          "value": {
            "literal": "recovering"
          }
        }
      ],
      "limits": [
        "The attempt is not refused when requested tasks exceed remaining daily staff capacity; the capacity total can expose overcommitment.",
        "One care action advances the cohort stay by one day regardless of task count because no task-to-stay conversion is represented.",
        "Recovery probability and mortality risks are not resolved because effects cannot express stochastic outcomes."
      ],
      "mechanic_id": "provide-patient-care-v1",
      "parameters": {
        "task_count": [
          1,
          10,
          30,
          60
        ]
      },
      "participants": {
        "patient_group": {
          "categories": [
            "flu patient",
            "patient group"
          ],
          "components": [
            "patient_group"
          ]
        }
      },
      "rationale": "Clinical staff spend the requested daily capacity on a colocated patient group, advance its stay by one day, and mark it as recovering.",
      "schema_version": "world-substrate-action-mechanic/v0",
      "semantic_bindings": [
        "task_count consumes daily staff capacity",
        "care advances length_of_stay_remaining by one day",
        "recovering identifies a cared-for cohort eligible for discharge when its stay reaches zero"
      ],
      "tests": [
        "Providing positive care to a colocated nonempty cohort consumes the requested staff capacity and reduces remaining stay by one.",
        "A zero or negative task count is refused.",
        "Care is refused when no stay remains or the cohort is recovered.",
        "Care exceeding remaining staff capacity is allowed to begin and can make daily capacity negative."
      ],
      "version": "1.0.0"
    },
