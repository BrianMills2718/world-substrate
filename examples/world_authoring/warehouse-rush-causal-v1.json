{
  "schema_version": "world-substrate-causal-model/v0",
  "mechanics": [
    {
      "schema_version": "world-substrate-action-mechanic/v0",
      "mechanic_id": "warehouse.action.move",
      "version": "1",
      "action_kind": "move",
      "rationale": "A worker can walk between the three represented warehouse locations at an energy cost.",
      "actor_selector": {
        "categories": [
          "worker"
        ],
        "components": [
          "worker"
        ]
      },
      "participants": {},
      "parameters": {
        "location": [
          "staging",
          "dock-a",
          "dock-b"
        ]
      },
      "checks": [
        {
          "label": "actor has free hands",
          "left": {
            "participant": {
              "name": "actor",
              "path": "components.worker.hands_free"
            }
          },
          "op": "eq",
          "right": {
            "literal": true
          }
        },
        {
          "label": "location differs from current location",
          "left": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          },
          "op": "ne",
          "right": {
            "action_field": "location"
          }
        },
        {
          "label": "actor has energy",
          "left": {
            "participant": {
              "name": "actor",
              "path": "components.worker.energy"
            }
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        }
      ],
      "effects": [
        {
          "participant": "actor",
          "path": "location.location_id",
          "op": "set",
          "value": {
            "action_field": "location"
          }
        },
        {
          "participant": "actor",
          "path": "components.worker.energy",
          "op": "subtract",
          "value": {
            "literal": 1
          }
        }
      ],
      "limits": [
        "Movement does not move unowned cargo or equipment."
      ],
      "tests": [
        "worker changes location and loses one energy"
      ],
      "semantic_bindings": []
    },
    {
      "schema_version": "world-substrate-action-mechanic/v0",
      "mechanic_id": "warehouse.action.claim-forklift",
      "version": "1",
      "action_kind": "claim-forklift",
      "rationale": "A free-handed worker can claim an available portable forklift at the same location.",
      "actor_selector": {
        "categories": [
          "worker"
        ],
        "components": [
          "worker"
        ]
      },
      "participants": {
        "forklift": {
          "categories": [
            "forklift"
