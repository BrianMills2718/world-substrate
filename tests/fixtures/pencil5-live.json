    "mechanic_id": "cut-cedar",
    "version": "1",
    "action_kind": "cut-cedar",
    "rationale": "Cutting cedar produces logs for the logger; no represented reserve supports a depletion effect.",
    "actor_selector": {
     "categories": [
      "actor",
      "logger"
     ],
     "components": [
      "stock"
     ]
    },
    "participants": {},
    "parameters": {
