{
  "mechanics": [
    {
      "action_kind": "admit-flu-patients",
      "actor_selector": {
        "categories": [
          "hospital"
        ],
        "components": [
          "hospital"
        ]
      },
      "checks": [
        {
          "label": "the patient group is at the hospital",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "location.location_id"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          }
        },
        {
          "label": "the admission quantity is positive",
          "left": {
            "action_field": "quantity"
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        },
        {
          "label": "the patients are hospitalized flu patients",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.illness_stage"
            }
          },
          "op": "eq",
          "right": {
            "literal": "hospitalized"
          }
        }
      ],
      "effects": [
        {
          "op": "add",
          "participant": "patient_group",
          "path": "components.patient_group.patient_count",
          "value": {
            "action_field": "quantity"
          }
        },
        {
          "op": "add",
          "participant": "actor",
          "path": "components.hospital.occupied_beds",
          "value": {
            "action_field": "quantity"
          }
        },
        {
          "op": "subtract",
          "participant": "actor",
          "path": "components.hospital.available_beds",
          "value": {
            "action_field": "quantity"
          }
        }
      ],
      "limits": [
        "The incoming-patient component represents an arrival rate rather than a waiting-patient stock, so admission does not debit a separate queue.",
        "The action does not refuse an attempt for insufficient beds or daily admission capacity; those resources may become overcommitted.",
        "The caller must bind the hospitalized flu-patient group as the admission destination."
      ],
      "mechanic_id": "admit-flu-patients-v1",
      "parameters": {
        "quantity": [
          1,
          2,
          4
        ]
      },
      "participants": {
        "patient_group": {
          "categories": [
            "flu patient",
            "patient group"
          ],
          "components": [
            "patient_group"
          ]
        }
      },
      "rationale": "The hospital records admitted patients in the hospitalized group and updates occupied and available beds by the requested quantity.",
      "schema_version": "world-substrate-action-mechanic/v0",
      "semantic_bindings": [
        "quantity is the number of flu patients admitted",
        "patient_group is the hospitalized destination cohort",
        "the hospital is the bed holder"
      ],
      "tests": [
        "Admitting one hospitalized flu patient at the hospital increases patient count and occupied beds by one and decreases available beds by one.",
        "A zero or negative quantity is refused.",
        "A patient group at another location is refused.",
        "An attempt larger than available beds is permitted to begin and can expose overcommitment in the bed totals."
      ],
      "version": "1.0.0"
    },
    {
      "action_kind": "assess-ventilation-need",
      "actor_selector": {
        "categories": [
          "clinical staff",
          "actor"
        ],
        "components": [
          "clinical_staff"
        ]
      },
      "checks": [
        {
          "label": "the patients are with the clinical staff",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "location.location_id"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          }
        },
        {
          "label": "the patient group has patients",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.patient_count"
            }
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        },
        {
          "label": "the patients have not received ventilation",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.ventilation_status"
            }
          },
          "op": "eq",
          "right": {
            "literal": "not ventilated"
          }
        },
        {
          "label": "the patients are hospitalized",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.illness_stage"
            }
          },
          "op": "ne",
          "right": {
            "literal": "recovered"
          }
        }
      ],
      "effects": [
        {
          "op": "set",
          "participant": "patient_group",
          "path": "components.patient_group.ventilation_status",
          "value": {
            "literal": "needs ventilation"
          }
        }
      ],
      "limits": [
        "The available state cannot encode a stochastic assessment result, so this mechanic represents only an assessment that finds ventilation is needed.",
        "The ventilation need probability remains unchanged because it describes cohort risk rather than the recorded assessment outcome.",
        "Assessment does not consume staff capacity because no assessment workload amount is supplied by the action."
      ],
      "mechanic_id": "assess-ventilation-need-v1",
      "parameters": {},
      "participants": {
        "patient_group": {
          "categories": [
            "flu patient",
            "patient group"
          ],
          "components": [
            "patient_group"
          ]
        }
      },
      "rationale": "Clinical staff can assess a colocated hospitalized cohort; this mechanic represents the positive assessment outcome by marking the cohort as needing ventilation.",
      "schema_version": "world-substrate-action-mechanic/v0",
      "semantic_bindings": [
        "ventilation_status records the positive clinical assessment",
        "ventilation_need_probability remains a background risk characteristic"
      ],
      "tests": [
        "Clinical staff can mark colocated nonempty unventilated patients as needing ventilation.",
        "An empty patient group is refused.",
        "A recovered patient group is refused.",
        "Patients already marked as needing ventilation or ventilated are refused."
      ],
      "version": "1.0.0"
    },
    {
      "action_kind": "assign-ventilators",
      "actor_selector": {
        "categories": [
          "clinical staff",
          "actor"
        ],
        "components": [
          "clinical_staff"
        ]
      },
      "checks": [
        {
