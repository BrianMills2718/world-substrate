        "name": "actor",
        "path": "location.location_id"
       }
      },
      "op": "eq",
      "right": {
       "participant": {
        "name": "to",
        "path": "location.location_id"
       }
      }
     }
    ],
    "effects": [
     {
      "participant": "source",
      "path": "components.stock.logs",
      "op": "subtract",
      "value": {
       "action_field": "quantity"
      }
     },
     {
      "participant": "to",
      "path": "components.stock.slats",
