            }
          },
          "op": "eq",
          "right": {
            "literal": "loading"
          }
        },
        {
          "label": "truck is full",
          "left": {
            "participant": {
              "name": "truck",
              "path": "components.truck.loaded"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "truck",
              "path": "components.truck.capacity"
            }
          }
        },
        {
          "label": "actor is at truck dock",
          "left": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "truck",
              "path": "location.location_id"
            }
          }
        }
      ],
      "effects": [
        {
          "participant": "truck",
          "path": "components.truck.status",
          "op": "set",
          "value": {
            "literal": "dispatched"
          }
        }
      ],
      "limits": [
        "Dispatch does not remove cargo or truck state."
      ],
      "tests": [
        "full truck at actor location becomes dispatched"
      ],
      "semantic_bindings": []
    }
  ],
  "terminal": {
    "mode": "all",
    "selector": {
      "categories": [
        "truck"
      ],
      "components": [
        "truck"
      ]
    },
    "checks": [
      {
        "path": "components.truck.status",
        "op": "eq",
        "value": "dispatched"
      }
    ]
  }
}
