  "mechanics": [
   {
    "schema_version": "world-substrate-action-mechanic/v0",
    "mechanic_id": "cut-cedar",
    "version": "1",
    "action_kind": "cut-cedar",
    "rationale": "The logger cuts the stated quantity of standing cedar into logs.",
    "actor_selector": {
     "categories": [
      "actor",
      "logger"
     ],
     "components": [
      "business"
     ]
    },
    "participants": {
     "forest": {
      "categories": [
       "forest"
      ],
      "components": [
       "forest"
      ]
     }
    },
    "parameters": {
     "quantity": [
      1
     ]
    },
    "checks": [
     {
      "label": "The quantity is positive",
      "left": {
       "action_field": "quantity"
      },
      "op": "gt",
      "right": {
       "literal": 0
      }
     },
     {
      "label": "The forest has enough standing cedar",
      "left": {
       "participant": {
        "name": "forest",
        "path": "components.forest.standing_cedar"
       }
      },
      "op": "gte",
      "right": {
       "action_field": "quantity"
      }
     }
    ],
    "effects": [
     {
      "participant": "forest",
      "path": "components.forest.standing_cedar",
      "op": "subtract",
      "value": {
       "action_field": "quantity"
      }
     },
     {
      "participant": "actor",
      "path": "components.business.logs",
      "op": "add",
      "value": {
       "action_field": "quantity"
      }
     }
    ],
    "limits": [
     "Only the represented standing-cedar stock and the logger's logs change; transport and forest renewal are not represented by this move."
    ],
    "tests": [
     "Refuse a zero or negative quantity.",
     "Refuse a cut exceeding standing cedar; otherwise reduce standing cedar and increase the logger's logs equally."
    ],
    "semantic_bindings": [
     "forest is the cut-cedar action's forest",
     "actor is the logger"
    ]
   },
