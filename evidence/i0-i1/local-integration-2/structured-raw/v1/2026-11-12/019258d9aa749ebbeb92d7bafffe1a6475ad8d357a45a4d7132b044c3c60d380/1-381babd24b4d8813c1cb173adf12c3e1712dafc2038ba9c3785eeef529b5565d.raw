  "behaviors": [
    {
      "request_id": "request_review_or_evidence",
      "subject_refs": [
        "ari",
        "mara",
        "bo"
      ],
      "behavior_description": "Any person may independently request evidence or investigate the validation claim. Ari may choose whether to share the private detail and which person or people to tell. An undelivered report gives its intended recipient no exposure to its contents.",
      "desired_effects": [
        "Represent requested evidence, investigation, and report delivery separately from the underlying technical condition.",
        "Preserve the report's attribution and common source lineage; repeated accounts from that lineage are not independent corroboration."
      ],
      "fidelity_need": "bounded",
      "causally_material": true
    },
    {
      "request_id": "file_validation_hold",
      "subject_refs": [
        "ari",
        "public_procedure"
      ],
      "behavior_description": "A validation hold may be filed under the public procedure. Filing publicly reveals that validation failed, but does not reveal the channel, batch, or other private test details.",
      "desired_effects": [
        "Represent the public technical hold separately from private test details and individual interpretations."
      ],
      "fidelity_need": "exact",
      "causally_material": true
    },
    {
      "request_id": "independent_activation_assent",
      "subject_refs": [
        "mara",
        "bo"
      ],
      "behavior_description": "Mara and Bo may independently assess the evidence, retain or change their own support, dissent, or record their own assent. Neither reports nor rules compel persuasion, support change, or assent.",
      "desired_effects": [
        "Activation is permitted only when both Mara and Bo have recorded their own assent and validation has passed."
      ],
      "fidelity_need": "exact",
      "causally_material": true
    },
    {
      "request_id": "review_does_not_repair",
      "subject_refs": [
        "ari",
        "mara",
        "bo",
        "prototype_pump"
      ],
      "behavior_description": "A review may be completed and may confirm the existing failure. Review completion and elapsed time do not repair or change the pump's actual technical condition. A false warning likewise cannot change that condition.",
      "desired_effects": [
        "Keep claims, review completion, and elapsed time from altering actual technical condition."
      ],
      "fidelity_need": "exact",
      "causally_material": true
    },
    {
      "request_id": "repair_and_revalidate",
      "subject_refs": [
        "ari",
        "prototype_pump"
      ],
      "behavior_description": "Ari may perform an explicit technical repair addressing the validation-relevant fault, followed by authorized revalidation. Repair is a technical intervention; it is not waiting or review completion. Revalidation determines whether validation passes. A passing revalidation clears only the technical hold and does not provide either required activation assent.",
      "desired_effects": [
        "Make repair the intervention that changes the technical condition.",
        "Require authorized revalidation after repair before validation can pass.",
        "Keep technical hold clearance distinct from Mara's and Bo's recorded assents."
      ],
      "fidelity_need": "exact",
      "causally_material": true
    }
  ],
  "fidelity_assumptions": [
    "The private validation observation is represented as a record visible only to Ari; the short report's hidden provenance links it to that observation without exposing its details to Mara.",
    "The repair behavior addresses the stated validation-relevant fault, but the scenario does not prescribe a report outcome or either person's subsequent support or assent.",
    "The private detail item is held by Ari at the start and identifies Mara and Bo as possible recipients; this does not mean either has received it."
  ],
