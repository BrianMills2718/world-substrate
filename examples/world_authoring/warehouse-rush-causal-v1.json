            "literal": true
          }
        },
        {
          "label": "forklift is shared",
          "left": {
            "participant": {
              "name": "forklift",
              "path": "ownership.owner_ref"
            }
          },
          "op": "eq",
          "right": {
            "literal": "place:warehouse"
          }
        },
        {
          "label": "forklift is colocated",
          "left": {
            "participant": {
              "name": "forklift",
              "path": "location.location_id"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          }
        },
        {
          "label": "forklift is portable",
          "left": {
            "participant": {
              "name": "forklift",
              "path": "portable.portable"
            }
          },
          "op": "eq",
          "right": {
            "literal": true
          }
        }
      ],
      "effects": [
        {
          "participant": "forklift",
          "path": "ownership.owner_ref",
          "op": "set",
          "value": {
            "owner_ref": "actor"
          }
        },
        {
          "participant": "actor",
          "path": "components.worker.hands_free",
          "op": "set",
          "value": {
            "literal": false
          }
        }
      ],
      "limits": [
        "One worker can hold one forklift through the represented hands-free flag."
      ],
      "tests": [
        "free-handed colocated worker can claim a shared forklift"
      ],
      "semantic_bindings": []
    },
    {
      "schema_version": "world-substrate-action-mechanic/v0",
      "mechanic_id": "warehouse.action.release-forklift",
      "version": "1",
      "action_kind": "release-forklift",
      "rationale": "A worker can leave a held forklift at the worker current location.",
      "actor_selector": {
        "categories": [
          "worker"
        ],
