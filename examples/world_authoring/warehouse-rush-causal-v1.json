            }
          }
        },
        {
          "participant": "actor",
          "path": "components.worker.hands_free",
          "op": "set",
          "value": {
            "literal": true
          }
        }
      ],
      "limits": [
        "Release records the forklift at the actor location."
      ],
      "tests": [
        "held forklift becomes shared at current location"
      ],
      "semantic_bindings": []
    },
    {
      "schema_version": "world-substrate-action-mechanic/v0",
      "mechanic_id": "warehouse.action.drive-forklift",
      "version": "1",
      "action_kind": "drive-forklift",
      "rationale": "A worker holding a colocated forklift can drive it empty between represented warehouse locations at an energy cost.",
      "actor_selector": {
        "categories": [
          "worker"
        ],
