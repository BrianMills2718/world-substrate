     ]
    },
    "checks": [
     {
      "label": "the quantity is positive",
      "left": {
       "action_field": "quantity"
      },
      "op": "gt",
      "right": {
       "literal": 0
      }
     }
    ],
    "effects": [
     {
      "participant": "actor",
      "path": "components.stock.logs",
      "op": "add",
      "value": {
       "action_field": "quantity"
      }
     }
    ],
    "limits": [
