    {
      "action_kind": "order-ventilators",
      "actor_selector": {
        "categories": [
          "ventilator",
          "medical equipment"
        ],
        "components": [
          "ventilator_stock"
        ]
      },
      "checks": [
        {
          "label": "the supplier can serve the hospital location",
          "left": {
            "participant": {
              "name": "supplier",
              "path": "location.location_id"
