  "classes": [
    {
      "id": "Substrate",
      "definition": "Fixed code every world runs through: the Engine, compiler, run loop, service, records."
    },
    {
      "id": "Family",
      "definition": "Reusable compiled people-world parts; the scenario explicitly chooses the legacy decision family or the independent validation/assent procedure. Not every family applies to every world."
    },
    {
      "id": "PerWorld",
      "definition": "Not code: an AI writes it for each described world during the build."
    },
    {
      "id": "Reference",
      "definition": "Hand-written code for the reference worlds (Kitchen, Waltzman and others); no generated world uses it today."
    },
    {
      "id": "Theory",
      "definition": "Named in decisions or the roadmap, not on the live path."
    }
  ],
  "ambiguous": [
    {
      "word": "rule",
      "means": [
        "mechanic",
        "world-law"
      ],
      "note": "An installed mechanic supplies executable effects; a declared world law constrains possible effects. State which authority is intended."
    },
    {
      "word": "review",
      "means": [
        "review",
        "rules-review"
      ],
      "note": "Operating review within a simulated world differs from the authoring-stage review of proposed rules."
    },
    {
      "word": "person",
      "means": [
        "person",
        "resident"
      ],
      "note": "The represented person and the external cognition agent operating its policy are distinct; use person or resident explicitly."
    },
    {
      "word": "approval",
      "means": [
        "approval",
        "recorded-assent"
      ],
      "note": "The outer user approves execution of rules; a represented person independently records assent inside the world. One cannot supply the other."
    }
  ]
