          "left": {
            "participant": {
              "name": "patient_group",
              "path": "location.location_id"
            }
          },
          "op": "eq",
          "right": {
            "participant": {
              "name": "actor",
              "path": "location.location_id"
            }
          }
        },
        {
          "label": "the assignment quantity is positive",
          "left": {
            "action_field": "quantity"
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        },
        {
          "label": "the patients need ventilation",
          "left": {
            "participant": {
              "name": "patient_group",
              "path": "components.patient_group.ventilation_status"
            }
          },
          "op": "eq",
          "right": {
