{"actions":[{"kind":"request-evidence","description":"Request a specific evidence item; this does not itself deliver the evidence or change the pump's technical condition.","fields":[{"name":"evidence","type":"entity_ref"}],"for_behaviors":["request_review_or_evidence"]},{"kind":"investigate-claim","description":"Independently investigate a claim; investigation may confirm failure and does not change the pump's technical condition.","fields":[{"name":"claim","type":"entity_ref"}],"for_behaviors":["request_review_or_evidence"]},{"kind":"author-report","description":"Create an attributed report about a claim addressed to a named recipient. The report may be a warning, including a false warning; delivery remains a separate action.","fields":[{"name":"recipient","type":"entity_ref"},{"name":"claim","type":"entity_ref"}],"for_behaviors":["choose_report_recipients","false_warning_does_not_change_condition"]}]}