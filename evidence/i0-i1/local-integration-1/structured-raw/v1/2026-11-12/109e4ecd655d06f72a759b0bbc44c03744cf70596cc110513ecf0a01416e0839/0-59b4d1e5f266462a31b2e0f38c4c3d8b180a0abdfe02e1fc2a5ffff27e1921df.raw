{"actions":[{"kind":"request-evidence","description":"The person attempting it independently requests evidence about a chosen subject; this does not compel anyone to provide it.","fields":[{"name":"subject","type":"entity_ref"},{"name":"evidence_kind","type":"string"}],"for_behaviors":["request_or_share_evidence"]},{"kind":"investigate-subject","description":"The person attempting it chooses to investigate a subject and may gather evidence.","fields":[{"name":"subject","type":"entity_ref"}],"for_behaviors":["request_or_share_evidence"]},{"kind":"compose-attributable-report","description":"Ari may choose to compose an attributable report based on evidence and designate one recipient. The report can then be delivered using the existing communicate action; it reaches only recipients to whom it is delivered.","fields":[{"name":"subject","type":"entity_ref"},{"name":"report_content","type":"string"},{"name":"recipient","type":"entity_ref"}],"for_behaviors":["request_or_share_evidence"]},{"kind":"conduct-validation-review","description":"The person attempting it chooses to review available evidence for the validation decision; the review may confirm the failed validation.","fields":[{"name":"validation_decision","type":"entity_ref"}],"for_behaviors":["review_validation"]}]}