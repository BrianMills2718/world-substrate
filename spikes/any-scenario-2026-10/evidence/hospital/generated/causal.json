        {
          "op": "add",
          "participant": "actor",
          "path": "components.ventilator_stock.functional_count",
          "value": {
            "action_field": "quantity"
          }
        }
      ],
      "limits": [
        "The action does not refuse an attempt for insufficient supplier stock; shortage is exposed by the supplier total.",
        "No pending-order quantity or delivery clock is represented, so colocated fulfillment is recorded immediately despite the supplier's descriptive lead-time field.",
        "The maximum order quantity is enforced as an ordering rule rather than a success-resource check."
