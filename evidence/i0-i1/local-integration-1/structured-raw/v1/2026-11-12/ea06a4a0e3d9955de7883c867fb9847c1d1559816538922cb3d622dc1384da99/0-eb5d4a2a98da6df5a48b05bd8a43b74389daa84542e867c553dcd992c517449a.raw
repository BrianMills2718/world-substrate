{"actions":[{"kind":"request-evidence","description":"Any actor may choose to request evidence about the referenced subject. This does not deliver evidence or compel anyone to provide it.","fields":[{"name":"subject","type":"entity_ref"}],"for_behaviors":["request_or_share_evidence"]},{"kind":"investigate-evidence","description":"Any actor may choose to investigate the referenced subject for evidence. Findings do not automatically change validation, stance, or assent.","fields":[{"name":"subject","type":"entity_ref"}],"for_behaviors":["request_or_share_evidence"]},{"kind":"prepare-attributable-report","description":"Ari may choose to prepare an attributable report from the referenced validation evidence, retaining its source lineage. Preparing it does not deliver it; Ari chooses named recipients using the existing communicate action.","fields":[{"name":"source","type":"entity_ref"}],"for_behaviors":["request_or_share_evidence"]}]}