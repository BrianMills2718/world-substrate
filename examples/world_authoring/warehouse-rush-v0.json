  "actions": [
    {
      "kind": "move",
      "description": "Walk empty-handed to one represented warehouse location: staging, dock-a, or dock-b.",
      "fields": [
        {
          "name": "location",
          "type": "string"
        }
      ]
    },
    {
      "kind": "claim-forklift",
      "description": "Take one available forklift at the worker location when the worker has free hands.",
      "fields": [
        {
          "name": "forklift",
          "type": "entity_ref"
        }
      ]
    },
    {
      "kind": "release-forklift",
      "description": "Leave a held forklift at the worker current location and free the worker hands.",
      "fields": [
        {
          "name": "forklift",
          "type": "entity_ref"
        }
      ]
    },
    {
      "kind": "drive-forklift",
      "description": "Drive a held colocated forklift without cargo to one represented warehouse location: staging, dock-a, or dock-b; worker and forklift arrive together.",
      "fields": [
        {
          "name": "forklift",
          "type": "entity_ref"
        },
        {
          "name": "location",
          "type": "string"
        }
      ]
    },
    {
      "kind": "transport-cargo",
      "description": "Drive a held forklift with one staged cargo unit from staging to one physical dock, dock-a or dock-b; route labels east/west are NOT dock ids. Worker, forklift, and cargo arrive together.",
      "fields": [
        {
          "name": "cargo",
          "type": "entity_ref"
        },
        {
          "name": "forklift",
          "type": "entity_ref"
        },
        {
          "name": "dock",
          "type": "string"
        }
      ]
    },
    {
      "kind": "load-cargo",
      "description": "Load staged cargo into a colocated truck using a held forklift when cargo.route equals truck.route and capacity remains.",
      "fields": [
        {
          "name": "cargo",
          "type": "entity_ref"
        },
        {
          "name": "truck",
          "type": "entity_ref"
        },
        {
          "name": "forklift",
          "type": "entity_ref"
        }
      ]
    },
    {
      "kind": "dispatch-truck",
      "description": "Dispatch a full truck from its dock.",
      "fields": [
        {
          "name": "truck",
          "type": "entity_ref"
        }
      ]
    }
