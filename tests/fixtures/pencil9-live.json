   {
    "schema_version": "world-substrate-action-mechanic/v0",
    "mechanic_id": "cut-cedar",
    "version": "1",
    "action_kind": "cut-cedar",
    "rationale": "Cutting cedar produces logs for the sawmill; the represented logging stock is the available reserve.",
    "actor_selector": {
     "categories": [
      "logger"
     ],
     "components": [
      "stock"
     ]
    },
    "participants": {},
    "parameters": {
     "quantity": [
      1,
      2,
      5
     ]
    },
    "checks": [
     {
      "label": "the quantity is positive",
      "left": {
       "action_field": "quantity"
      },
      "op": "gt",
      "right": {
       "literal": 0
      }
     },
     {
      "label": "the logging business has enough cedar logs",
      "left": {
       "participant": {
        "name": "actor",
        "path": "components.stock.logs"
       }
      },
      "op": "gte",
      "right": {
       "action_field": "quantity"
      }
     }
    ],
    "effects": [
     {
      "participant": "actor",
      "path": "components.stock.logs",
      "op": "subtract",
      "value": {
       "action_field": "quantity"
      }
     }
    ],
    "limits": [
     "The represented logging stock is treated as the available cedar reserve; regrowth is represented by a world process."
    ],
    "tests": [
     "Cutting a positive quantity no greater than available logs subtracts that quantity; zero or an excessive quantity is refused."
    ],
    "semantic_bindings": [
     "quantity is the number of cedar logs cut",
     "logger logs are the available cedar reserve"
    ]
