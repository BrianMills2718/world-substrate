            }
          },
          "op": "ne",
          "right": {
            "action_field": "location"
          }
        },
        {
          "label": "actor has energy",
          "left": {
            "participant": {
              "name": "actor",
              "path": "components.worker.energy"
            }
          },
          "op": "gt",
          "right": {
            "literal": 0
          }
        }
      ],
      "effects": [
        {
          "participant": "actor",
          "path": "location.location_id",
          "op": "set",
          "value": {
            "action_field": "location"
          }
        },
        {
          "participant": "forklift",
          "path": "location.location_id",
          "op": "set",
          "value": {
            "action_field": "location"
          }
        },
        {
          "participant": "actor",
          "path": "components.worker.energy",
          "op": "subtract",
