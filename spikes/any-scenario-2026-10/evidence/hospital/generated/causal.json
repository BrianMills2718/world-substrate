            "actor"
          ],
          "components": [
            "supplier_stock"
          ]
        }
      },
      "rationale": "The hospital ventilator stock acquires ordered units from the selected supplier, while the supplier's available stock falls by the same quantity.",
      "schema_version": "world-substrate-action-mechanic/v0",
      "semantic_bindings": [
        "quantity transfers ventilator stock from supplier availability to hospital ownership",
        "maximum_order_quantity_per_day is a permissibility limit",
        "ordered units enter functional stock on represented fulfillment"
      ],
      "tests": [
        "An order within the daily maximum reduces supplier stock and increases owned and functional hospital ventilators equally.",
        "A zero or negative order is refused.",
        "An order above the supplier's daily maximum is refused.",
        "An order within the maximum remains permissible when supplier stock is lower than the order."
      ],
      "version": "1.0.0"
    },
