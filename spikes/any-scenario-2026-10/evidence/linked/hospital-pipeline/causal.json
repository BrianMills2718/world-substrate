      ],
      "limits": [
        "The action cannot update occupied or available beds because the hospital is not an action participant.",
        "The represented state has no separate arrival queue, so patient_count serves as the admitted census.",
        "Admission quantity is conservatively limited to one patient per action.",
        "Bed availability and daily admission capacity are not enforceable through this action's participants."
      ],
      "mechanic_id": "admit-represented-flu-patient",
      "parameters": {
        "quantity": [
          1
        ]
      },
      "participants": {
        "patient_group": {
          "categories": [
            "patients",
            "patient-group"
          ],
          "components": [
            "patient_group"
          ]
        }
      },
      "rationale": "Clinical staff may add a represented arriving patient to the hospital patient census. The action is limited to one patient because the action has no hospital participant through which bed and daily admission limits could be updated safely.",
      "schema_version": "world-substrate-action-mechanic/v0",
      "semantic_bindings": [
        "patient_group denotes the represented flu-patient census",
        "quantity denotes newly admitted patients",
        "clinical-staff role performs admission"
      ],
      "tests": [
        "Clinical staff can admit one co-located flu patient group belonging to the same hospital.",
        "A quantity of zero or two is refused.",
        "A patient group at another location is refused.",
        "A patient group belonging to another hospital is refused.",
        "A successful admission increases patient_count by one and changes no bed stock."
      ],
      "version": "1.0.0"
    },
