    "mechanic_id": "cut-cedar-stock",
    "version": "1",
    "action_kind": "cut-cedar",
    "rationale": "Cutting cedar adds logs to the logger's represented stock.",
    "actor_selector": {
     "categories": [
      "logger"
     ],
     "components": [
      "cedar_stock"
     ]
    },
    "participants": {},
